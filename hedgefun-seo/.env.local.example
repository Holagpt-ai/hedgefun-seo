# ─── Polygon API ─────────────────────────────────────────
POLYGON_API_KEY=your_polygon_api_key

# ─── IndexNow ────────────────────────────────────────────
INDEXNOW_KEY=your_indexnow_key

# ─── Admin Dashboard ─────────────────────────────────────
ADMIN_PASSWORD=your_secure_admin_password
